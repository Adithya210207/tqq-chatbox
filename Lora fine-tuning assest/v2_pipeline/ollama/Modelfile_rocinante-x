# Rocinante-X-12B with the chat format its author recommends
# ("Mistral v3 Tekken", no [SYSTEM_PROMPT]). Create it with:
#   ollama create rocinante-x -f Modelfile_rocinante-x
FROM hf.co/TheDrummer/Rocinante-X-12B-v1-GGUF:Q5_K_M

TEMPLATE """{{- range $i, $_ := .Messages }}{{- if eq .Role "user" }}[INST]{{ .Content }}[/INST]{{- else if eq .Role "assistant" }}{{ .Content }}</s>{{- end }}{{- end }}"""

PARAMETER stop "</s>"
PARAMETER stop "[INST]"
PARAMETER num_ctx 8192
